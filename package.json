{
	"name": "dial",
	"version": "0.0.1",
	"description": "A video player plugin for Obsidian with subtitle-video bidirectional binding, playback speed control, AB loop, and more.",
	"keywords": [
		"ab-loop",
		"obsidian",
		"playback",
		"player",
		"video"
	],
	"license": "MIT",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"oxfmt": "^0.52.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.60.0"
	},
	"packageManager": "pnpm@10.26.1"
}
